# Production Server Configuration Template
# 
# IMPORTANT: This is a TEMPLATE ONLY
# 
# For local development:
#   1. Copy this file to server.env
#   2. Fill in your actual values
#   3. NEVER commit server.env to version control
#   4. Add server.env to .gitignore (already done)
#
# For production CI/CD:
#   Use GitHub Secrets instead:
#   - Settings → Secrets and variables → Actions
#   - Create secrets for each variable below
#   - Reference them in .github/workflows/*.yml as ${{ secrets.SECRET_NAME }}

# Production domain
DOMAIN=example.com

# Production server IP address
SERVER_IP=192.0.2.1

# Dashboard credentials
DASH_USER=admin_placeholder
DASH_PASS=<GENERATE_STRONG_PASSWORD>

# CRM integration - use Authorization header instead of URL tokens
# Store actual token in GitHub Secret: CRM_AUTH_TOKEN
CRM_HOOK_URL=https://crm.example.com/api/webhooks/inbound
CRM_AUTH_TOKEN=<GENERATE_IN_GITHUB_SECRETS>

# Calltouch integration - use Authorization header instead of URL tokens
# Store actual token in GitHub Secret: CALLTOUCH_AUTH_TOKEN
CALLTOUCH_HOOK_URL=https://calltouch.example.com/api/webhooks/inbound
CALLTOUCH_AUTH_TOKEN=<GENERATE_IN_GITHUB_SECRETS>

# Deployment token for /internal/deploy endpoint
# Generate: openssl rand -hex 32
# Store in GitHub Secrets: DEPLOY_TOKEN
DEPLOY_TOKEN=<GENERATE_IN_GITHUB_SECRETS>

# Database configuration
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=businessway_prod
DB_USER=db_user
DB_PASSWORD=<GENERATE_IN_GITHUB_SECRETS>

# Healthcare data encryption key (HIPAA/GDPR compliance)
DATA_ENCRYPTION_KEY=<GENERATE_IN_GITHUB_SECRETS>

# Environment
NODE_ENV=production
