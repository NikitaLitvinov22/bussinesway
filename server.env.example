# Production Server Configuration Template
# 
# IMPORTANT: This is a TEMPLATE ONLY
# 
# For local development:
#   1. Copy this file to server.env
#   2. Fill in your actual values
#   3. NEVER commit server.env to version control
#   4. Add server.env to .gitignore (already done)
#
# For production CI/CD:
#   Use GitHub Secrets instead:
#   - Settings → Secrets and variables → Actions
#   - Create secrets for each variable below
#   - Reference them in .github/workflows/*.yml as ${{ secrets.SECRET_NAME }}

# Production domain
DOMAIN=analytics.businessway22.ru

# Production server IP address
SERVER_IP=xxx.xxx.xxx.xxx

# Dashboard credentials
DASH_USER=admin_user
DASH_PASS=<CHANGE_ME_TO_STRONG_PASSWORD>

# CRM integration webhook URL
# Format: https://crm.example.com/webhook/path?token=<token>
# SECURITY: Use HTTP headers for auth instead of URL params when possible
CRM_HOOK_URL=https://crm.example.com/hooks/crm/<token>

# Calltouch integration webhook URL  
# Format: https://calltouch.example.com/webhook/path?token=<token>
CALLTOUCH_HOOK_URL=https://calltouch.example.com/hooks/calltouch/<token>

# Deployment token for /internal/deploy endpoint
# Generate: openssl rand -hex 32
DEPLOY_TOKEN=<CHANGE_ME_TO_RANDOM_TOKEN>
